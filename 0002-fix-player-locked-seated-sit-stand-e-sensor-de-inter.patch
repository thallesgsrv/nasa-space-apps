From: claude <claude@example.com>
Date: Sat, 14 Nov 2026 19:07:24 +0000
Subject: [PATCH 2/3] fix(player): locked/seated, sit/stand e sensor de
 interacao; remove variavel sem uso

---
 scripts/mission.gd |  2 --
 scripts/player.gd  | 80 ++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 80 insertions(+), 2 deletions(-)

diff --git a/scripts/mission.gd b/scripts/mission.gd
index 062dcc0..0f37da7 100644
--- a/scripts/mission.gd
+++ b/scripts/mission.gd
@@ -225,7 +225,6 @@ func launch() -> Dictionary:
 	var downlink: float = ev["downlink"]
 	var duty: float = ev["duty"]
 	var fit: float = ev["fit"]
-	var storms := 0
 	var bus_failed := false
 	for month in range(1, months + 1):
 		if rng.randf() < (1.0 - BUS_RELIABILITY) / 12.0:
@@ -241,7 +240,6 @@ func launch() -> Dictionary:
 		var storm := 1.0
 		if ORBITS[orbit]["storm"] and rng.randf() < 0.08:
 			storm = 0.5
-			storms += 1
 			lines.append("Mês %d: tempestade solar reduziu os dados." % month)
 		var gen := 0.0
 		for id in active:
diff --git a/scripts/player.gd b/scripts/player.gd
index 8807dea..7524274 100644
--- a/scripts/player.gd
+++ b/scripts/player.gd
@@ -7,7 +7,19 @@ extends CharacterBody2D
 @export var speed: float = 300.0
 @export var roll_speed: float = 520.0
 
+const FONT := preload("res://assets/fonts/PixelOperator8.ttf")
+
+## Bloqueio externo (tutorial, cenas): o personagem fica parado e nao interage.
+var locked := false
+## Sentado na cadeira de comando (console de missao aberto).
+var seated := false
+
 @onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
+@onready var sensor: Area2D = get_node_or_null("InteractSensor") as Area2D
+
+var _prompt: Label
+var _target: Area2D
+var _interacting := false
 
 var _facing := "down"        # "down" | "up" | "side"
 var _flip := false           # true = olhando para a esquerda (so vale em "side")
@@ -21,11 +33,28 @@ func _ready() -> void:
 	_setup_input()
 	sprite.animation_finished.connect(_on_animation_finished)
 	_play("idle")
+	_prompt = Label.new()
+	_prompt.add_theme_font_override("font", FONT)
+	_prompt.add_theme_font_size_override("font_size", 24)
+	_prompt.add_theme_color_override("font_color", Color.WHITE)
+	_prompt.add_theme_color_override("font_outline_color", Color.BLACK)
+	_prompt.add_theme_constant_override("outline_size", 8)
+	_prompt.position = Vector2(-160, -130)
+	_prompt.size = Vector2(320, 30)
+	_prompt.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	_prompt.visible = false
+	add_child(_prompt)
 
 
 func _physics_process(_delta: float) -> void:
 	if _dead:
 		return
+	if _is_frozen():
+		velocity = Vector2.ZERO
+		_play("idle")
+		_update_prompt()
+		return
+	_update_prompt()
 	if _locked:
 		velocity = _roll_dir * roll_speed
 		move_and_slide()
@@ -118,3 +147,54 @@ func _setup_input() -> void:
 			var logical := InputEventKey.new()
 			logical.keycode = key
 			InputMap.action_add_event(action, logical)
+
+
+# ============================ interacao ============================
+func _is_frozen() -> bool:
+	return locked or seated or _interacting or UI.busy
+
+
+## Escolhe a zona interativa mais proxima e mostra "[F] nome".
+func _update_prompt() -> void:
+	_target = null
+	if sensor != null and not _is_frozen():
+		var best := INF
+		for area in sensor.get_overlapping_areas():
+			if area is Area2D and area.get("action") != null and String(area.get("action")) != "":
+				var d := global_position.distance_squared_to(area.global_position)
+				if d < best:
+					best = d
+					_target = area
+	if _target != null:
+		_prompt.text = "[F] " + String(_target.get("display_name"))
+	_prompt.visible = _target != null
+
+
+func _unhandled_input(event: InputEvent) -> void:
+	if _dead or event.is_echo() or _is_frozen():
+		return
+	if event.is_action_pressed("interact") and _target != null:
+		get_viewport().set_input_as_handled()
+		_interacting = true
+		_prompt.visible = false
+		await Interactions.run(String(_target.get("action")), _target, self)
+		_interacting = false
+	elif event.is_action_pressed("inventory"):
+		get_viewport().set_input_as_handled()
+		_interacting = true
+		await Interactions.open_inventory()
+		_interacting = false
+
+
+## Senta na cadeira (chamado pela sala de controle).
+func sit(pos: Vector2) -> void:
+	seated = true
+	velocity = Vector2.ZERO
+	global_position = pos
+	_facing = "down"
+	_play("idle", true)
+
+
+func stand(pos: Vector2) -> void:
+	global_position = pos
+	seated = false
-- 
